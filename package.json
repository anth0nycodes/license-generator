{
  "name": "@anth0nycodes/license-generator",
  "version": "1.0.1",
  "description": "An open-source CLI tool to generate licenses for your repository.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "publish:npm": "pnpm publish --access public"
  },
  "main": "dist/index.js",
  "bin": {
    "generate-license": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "license",
    "license-generator",
    "license-cli",
    "cli",
    "open-source",
    "oss",
    "node",
    "npm",
    "npx",
    "mit",
    "apache-2.0",
    "boilerplate",
    "project-setup",
    "scaffold"
  ],
  "author": "Anthony Hoang",
  "contributors": [
    {
      "name": "Samuel Yeboah-Asi",
      "url": "https://github.com/devv-sam"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anth0nycodes/license-generator.git"
  },
  "bugs": {
    "url": "https://github.com/anth0nycodes/license-generator/issues"
  },
  "homepage": "https://github.com/anth0nycodes/license-generator#readme",
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/node": "^26.1.2",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "axios": "^1.13.2",
    "commander": "^14.0.2",
    "inquirer": "^14.0.2",
    "picocolors": "^1.1.1"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
